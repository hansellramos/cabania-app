# Mapbox credentials (Vite lee del root)
VITE_MAPBOX_ACCESS_TOKEN=your-mapbox-access-token

# Email Provider ('smtp' by default, change to 'sendgrid' etc.)
EMAIL_PROVIDER=smtp

# SMTP Configuration (GoDaddy, Gmail, etc.)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@cabania.info

# Twilio (WhatsApp)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# App URL (for invitation links)
APP_URL=https://app.cabania.info

# PostHog (analytics). Frontend only sends from VITE_POSTHOG_HOSTS in a production build.
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com
VITE_POSTHOG_HOSTS=cabania.app,cabania.info
# true = send from any host and log to the console (local debugging; use a test project key)
VITE_POSTHOG_DEBUG=false
# Source map upload at build time (personal API key with error tracking write scope)
POSTHOG_CLI_TOKEN=
POSTHOG_CLI_ENV_ID=
